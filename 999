local gethui_ = gethui or function() return game:GetService("CoreGui") end
local TS = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local HTTP = (syn and syn.request) or http_request or request

-- ==========================================
-- SET YOUR SCRIPT URL HERE
-- ==========================================
local SCRIPT_URL = "https://raw.githubusercontent.com/Kixdev/99NITF/main/script"
-- ==========================================

-- Clean up old instances
local guiName = "GuestLoaderUI"
local old = gethui_():FindFirstChild(guiName) or game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild(guiName)
if old then old:Destroy() end

local THEME = {
    BG=Color3.fromRGB(10,12,20), SURF=Color3.fromRGB(18,21,32), SURF2=Color3.fromRGB(26,30,44),
    TEXT=Color3.fromRGB(226,232,240), DIM=Color3.fromRGB(148,163,184),
    ACCENT=Color3.fromRGB(99,102,241), ACCENT2=Color3.fromRGB(79,70,229), STROKE=Color3.fromRGB(71,85,105),
    GREEN_STROKE=Color3.fromRGB(74,222,128), DANGER=Color3.fromRGB(239,68,68)
}

local function corner(p,r) local c=Instance.new("UICorner",p); c.CornerRadius=UDim.new(0,r or 8); return c end
local function stroke(p,c,t,tr) local s=Instance.new("UIStroke",p); s.Color=c or THEME.STROKE; s.Thickness=t or 1; s.Transparency=tr or 0.4; return s end
local function tween(o,d,pr) TS:Create(o,TweenInfo.new(d or 0.14,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),pr):Play() end
local function shadow(parent) local i=Instance.new("ImageLabel",parent); i.AnchorPoint=Vector2.new(0.5,0.5); i.Position=UDim2.new(0.5,0,0.5,2); i.Size=UDim2.new(1,26,1,26); i.BackgroundTransparency=1; i.Image="rbxassetid://6014261993"; i.ImageColor3=Color3.new(0,0,0); i.ImageTransparency=0.72; i.ScaleType=Enum.ScaleType.Slice; i.SliceCenter=Rect.new(49,49,450,450); i.ZIndex=0; return i end

