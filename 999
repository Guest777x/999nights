-- Animation Helper
local function setProgress(percent, text, logStr)
    tween(barFill, 0.3, {Size = UDim2.new(percent / 100, 0, 1, 0)})
    if text then statusLabel.Text = text end
    if logStr then logText.Text = logStr end
end

-- Load Logic
task.spawn(function()
    task.wait(0.5)
    
    -- 1. Downloading
    setProgress(20, "Downloading payload...", "Fetching URL: raw.githubusercontent.com")
    local success, response = pcall(function()
        if type(HTTP) == "function" then
            return HTTP({Url = SCRIPT_URL, Method = "GET"}).Body
        else
            return game:HttpGet(SCRIPT_URL)
        end
    end)
    
    if not success or not response then
        setProgress(100, "Failed to connect", "Error: Network request failed")
        barFill.BackgroundColor3 = THEME.DANGER
        task.wait(3)
        gui:Destroy()
        return
    end
    
    -- 2. Compiling
    setProgress(50, "Downloaded!", "Payload size: " .. #response .. " bytes")
    task.wait(0.5)
    setProgress(70, "Compiling Lua...", "loadstring()")
    
    local compileSuccess, compiled = pcall(function()
        return loadstring(response)
    end)
    
    if not compileSuccess or not compiled then
        setProgress(100, "Compilation Error", tostring(compiled))
        barFill.BackgroundColor3 = THEME.DANGER
        task.wait(3)
        gui:Destroy()
        return
    end
    
    -- 3. Executing
    setProgress(90, "Executing...", "Running payload")
    task.wait(0.5)
    
    local execSuccess, execErr = pcall(compiled)
    if not execSuccess then
        logText.Text = "Execution Error: " .. tostring(execErr)
        logText.TextColor3 = THEME.DANGER
        statusLabel.Text = "Script Error"
        barFill.BackgroundColor3 = THEME.DANGER
    else
        setProgress(100, "Success!", "Done.")
        barFill.BackgroundColor3 = THEME.GREEN_STROKE
        statusLabel.Text = "Injected successfully"
        task.wait(1)
    end
    
    -- 4. Fade out
    tween(bg, 0.5, {BackgroundTransparency = 1})
    tween(root, 0.5, {BackgroundTransparency = 1})
    task.wait(0.5)
    gui:Destroy()
end)
