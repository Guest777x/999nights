gui.Name = guiName
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 2147483647 -- Max ZIndex to sit on top
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = gethui_()

-- Fade background
